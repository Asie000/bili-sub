# 复制成 .env 后按需修改（.env 已被 .gitignore 忽略）

# 本地 ASR 用的 Python 解释器。
# 相对路径会先按当前目录、找不到再按 bili-sub.exe 所在目录解析，
# 所以 venv 跟着项目移动时不用改这一行。
# 也可以写成绝对路径，例如：
# PYTHON_PATH=C:\Users\you\Desktop\BiliBili\.asr-venv\Scripts\python.exe
PYTHON_PATH=.asr-venv\Scripts\python.exe

# 转写模型。注释掉 = worker 默认 small；有 GPU 推荐 large-v3-turbo。
ASR_MODEL=large-v3-turbo

# 限流与并发：默认 2 req/s、3 并发，保守稳妥。
# 调到 8/8 会快，但更容易触发 B站 412 风控。
# BILI_QPS=2
# BILI_CONCURRENCY=3

# 数据目录（默认 data）
# BILI_DATA_DIR=data

# 繁转简（默认开；确实需要繁体原文时设 0）
# ASR_SIMPLIFY=0

# 登录 Cookie（一般用 `bili-sub login` 写 data/session.json，不需要在这里手填）
# SESSDATA=

# 预留项，当前链路不需要 ffmpeg
# FFMPEG_PATH=ffmpeg
